[Unit]
Description=SantehGo verified PostgreSQL and media backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/santehgo
ExecStart=/usr/bin/docker compose --profile ops run --rm backup /scripts/backup.sh
ExecStartPost=/opt/santehgo/docker/offsite-sync.sh
EnvironmentFile=/etc/santehgo-backup.env
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
